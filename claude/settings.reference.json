{
  "cleanupPeriodDays": 99999,
  "env": {
    "LANG": "en_US.UTF-8",
    "LC_ALL": "en_US.UTF-8",
    "PYTHONIOENCODING": "utf-8",
    "PYTHONUTF8": "1"
  },
  "permissions": {
    "deny": [
      "AskUserQuestion",
      "CronCreate",
      "CronDelete",
      "CronList",
      "DesignSync",
      "EnterPlanMode",
      "ExitPlanMode",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup"
    ]
  },
  "model": "opus",
  "disableBundledSkills": true,
  "disableRemoteControl": false,
  "disableWorkflows": true,
  "disableArtifact": true,
  "enabledPlugins": {
    "caveman@caveman": true,
    "claude-hud@claude-hud": true,
    "custom-visuals@power-bi-agentic-development": true,
    "etl@power-bi-agentic-development": true,
    "fabric-admin@power-bi-agentic-development": true,
    "fabric-cli@power-bi-agentic-development": true,
    "goblin-mode@power-bi-agentic-development": true,
    "paginated-reports@power-bi-agentic-development": true,
    "pbi-desktop@power-bi-agentic-development": true,
    "pbip@power-bi-agentic-development": true,
    "reports@power-bi-agentic-development": true,
    "semantic-models@power-bi-agentic-development": true,
    "tabular-editor@power-bi-agentic-development": true,
    "mattpocock-skills@mattpocock": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    },
    "power-bi-agentic-development": {
      "source": {
        "source": "github",
        "repo": "data-goblin/power-bi-agentic-development"
      }
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "low"
    }
  },
  "autoMemoryEnabled": false,
  "theme": "dark",
  "preferredNotifChannel": "terminal_bell",
  "autoCompactEnabled": false,
  "agentPushNotifEnabled": true
}
