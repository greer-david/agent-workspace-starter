# Git Bash in Herdr starts a LOGIN shell. Bash reads only the first of
# ~/.bash_profile, ~/.bash_login, ~/.profile that exists.
#
# - If none exist and ~/.bashrc does, Git for Windows creates ~/.bash_profile
#   itself ("# generated by Git for Windows"), sourcing ~/.profile and ~/.bashrc.
#   That file is correct; leave it.
# - If the active file already sources ~/.bashrc (directly or through
#   ~/.profile), change nothing.
# - Otherwise append this one line to the ACTIVE file:
[ -f ~/.bashrc ] && . ~/.bashrc
