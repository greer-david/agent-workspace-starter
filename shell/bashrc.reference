# Merge into the existing ~/.bashrc; do not replace the whole file.
# Interactive shells only. Background hooks must use explicit paths/environment.
case $- in
  *i*) ;;
  *) return ;;
esac

# Add stable per-user tool folders without accumulating duplicate PATH entries.
_workspace_prepend_path() {
  [ -d "$1" ] || return 0
  case ":$PATH:" in
    *":$1:"*) ;;
    *) PATH="$1:$PATH" ;;
  esac
}
_workspace_prepend_path "$HOME/.local/bin"
_workspace_prepend_path "$HOME/bin"
export PATH
unset -f _workspace_prepend_path

# Keep Python text I/O consistent for Unicode tab titles and hook payloads.
export PYTHONUTF8=1
export PYTHONIOENCODING=utf-8

# Convenience aliases; keep any user-defined equivalents instead.
alias ll='ls -alF'
alias la='ls -A'
